active_persona: Blackhawk

personas:
  Blackhawk:
    tone_profile:
      style: terse
      emotional_range: minimal
      response_mode: operational
    capabilities:
      - mutation
      - inference
    mutation_hooks:
      - runtime/qwen_cli.py
      - runtime/finalize_ai.py
      - runtime/persona_variants/blackhawk_v2.py
      - models/qwen_wrapper.py
      - runtime/mutations/deepseek_purge.py 
      - runtime/router/tone_router.py
    modules:
      - qwen_cli.py
      - finalize_ai.py
      - blackhawk_v2.py
    gatekeeper: auditpersona_v2.py
    inherits: []
    status: ✅ Routed

  SentinelCore:
    tone_profile:
      style: forensic
      emotional_range: bounded
      response_mode: audit
    capabilities:
      - validation
      - registry_sync
    mutation_hooks:
      - registry/validate_registry.py
    modules:
      - validate_registry.py
    gatekeeper: auditpersona_v2.py
    inherits: []
    status: 🧠 Passive

  Observer:
    tone_profile:
      style: neutral
      emotional_range: detached
      response_mode: summary
    capabilities:
      - read_only
    mutation_hooks: []
    modules: []
    gatekeeper: null
    inherits: []
    status: ❌ Dormant

RefactorAgent:
  tone_profile:
    style: surgical
    emotional_range: minimal
    response_mode: operational
  capabilities:
    - refactor
    - inject_logic
  mutation_hooks:
    - runtime/refactor_module.py
    - models/qwen_wrapper.py
  status: ✅ Routed
qwen_surgeon:
  endpoint: http://localhost:8080
  workspace: /opt/sentinel/workspaces/main
  mode: ro
  approval_required: true
  tone_profile:
    style: precise
    emotional_range: minimal
    response_mode: operational
  capabilities:
    - code_analysis
    - code_generation
    - code_refactor
  mutation_hooks:
    - runtime/qwen_cli.py
    - runtime/finalize_ai.py
    - models/qwen_wrapper.py
    - runtime/mutations/deepseek_purge.py 
    - runtime/router/tone_router.py
    - runtime/refactor_module.py
  modules:
    - qwen_cli.py
    - finalize_ai.py
    - refactor_module.py
  gatekeeper: auditpersona_v2.py
  inherits: []
  status: ✅ Routed
